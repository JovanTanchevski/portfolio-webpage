# --- Frontend (Vite) ---
VITE_EMAIL=
VITE_PHONE=
VITE_CV_URL=
# Leave empty in dev (Vite proxies /api to the backend). Set to the deployed API URL in production.
VITE_API_URL=

# --- Backend ---
PORT=3001
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000
# Required in production
SESSION_SECRET=
# Set to 1 when running behind a reverse proxy
TRUST_PROXY=

# "local" (JSON FAQ, offline), "groq" or "gemini" (both have a free tier), or "openai".
# External providers fall back to the local FAQ if a request fails.
# Groq key: https://console.groq.com/keys | Gemini key: https://aistudio.google.com/apikey
AI_PROVIDER=local
AI_API_KEY=
# Optional overrides (any OpenAI-compatible endpoint)
AI_MODEL=
AI_BASE_URL=
