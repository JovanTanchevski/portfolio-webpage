# --- Frontend (Vite) ---
VITE_EMAIL=
VITE_PHONE=
VITE_CV_URL=
# Leave empty in dev to use http://localhost:3001
VITE_API_URL=

# --- Backend ---
PORT=3001
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000
# Required in production
SESSION_SECRET=
# Set to 1 when running behind a reverse proxy
TRUST_PROXY=

# "local" (JSON FAQ, offline) or "openai". OpenAI falls back to local on failure.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
